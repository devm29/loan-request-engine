# Copy to .env next to docker-compose.yml; Compose substitutes these. Every one
# is optional: the stack boots and prices loans with none of them set.

# Session signing for the compose stack. Generate one with `bin/rails secret`.
SECRET_KEY_BASE=

# Enables the generated narrative on the term sheet. Unset, the deterministic
# explainer is used and every figure is the same either way.
ANTHROPIC_API_KEY=

# auto | rules | claude
LENDING_EXPLAINER=auto
